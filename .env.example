# Routt — environment. Copy to .env.local and fill in to go live.
# .env.local is gitignored; these keys are used SERVER-SIDE only and never reach
# the browser (the client calls /api/places, the server calls the providers).

# Data mode. "true" = mock (offline, default). Set BOTH to "false" to go live:
#  - NEXT_PUBLIC_USE_MOCK is what the browser reads (decides mock vs calling /api/places)
#  - USE_MOCK is the server/endpoint default
NEXT_PUBLIC_USE_MOCK=true
USE_MOCK=true

# Google Places (Places Nearby Search + Place Details)
GOOGLE_PLACES_KEY=

# Foursquare Places (v3 Search + Details/Tips)
FOURSQUARE_KEY=

# Reddit (OAuth "application-only" client-credentials app: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=routt/0.1 by u/your-username

# Ticketmaster Discovery (events, UAE coverage) — free key from developer.ticketmaster.com
TICKETMASTER_KEY=
